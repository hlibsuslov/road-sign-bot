# Copy to .env and fill in. The .env file is git-ignored and is passed to the
# container via docker-compose `env_file`.

# Telegram bot token from @BotFather (required)
BOT_TOKEN=

# SQLite database path. In production this points at /app/db, which is the
# `bot-db` named volume mounted in docker-compose.yml, so data survives rebuilds.
DB_PATH=/app/db/road_signs_bot.db
