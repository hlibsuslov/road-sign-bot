# Secrets — never commit
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Local SQLite DB (lives on the bot-db Docker volume in prod)
db/
*.db
*.sqlite3

# OS / editor cruft
.DS_Store
*.swp

# Pi-local ops files (auto-deploy script + its log) — NOT part of the bot source
deploy.sh
deploy.log
deploy.log.tmp
*.db.bak*

# Mini App build output (Dockerfile builds it)
webapp/dist/

# bot-ui: generated files (rebuild: py -3 tools/bot_ui_screens.py, tgui map export-snapshot)
bot-ui/.bot-ui/
bot-ui/.patches/
docs/telegram-ui/studio.html
